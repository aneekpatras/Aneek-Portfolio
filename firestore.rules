rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for security auditing and ABAC
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Dynamic Admin Identification Pattern
    function isAdmin() {
      return isEmailVerified() && (
        request.auth.token.email in [
          'aneekkhokhar90@gmail.com',
          'aneekkhokhar2@gmail.com',
          'aneekkhokhar3@gmail.com'
        ] || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. Projects Rules match block
    match /projects/{projectId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(projectId) && isValidProject(incoming());
      allow update: if isAdmin() && isValidId(projectId) && isValidProject(incoming());
      allow delete: if isAdmin() && isValidId(projectId);
    }

    function isValidProject(data) {
      return data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 200
        && data.category is string && data.category.size() <= 200
        && data.subtitle is string && data.subtitle.size() <= 1000
        && (data.image is string && data.image.size() <= 1000)
        && (data.status in ['published', 'draft'])
        && (data.displayOrder is int)
        && (data.tags is list && data.tags.size() <= 20);
    }

    // 2. Experience Rules match block
    match /experience/{experienceId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(experienceId) && isValidExperience(incoming());
      allow update: if isAdmin() && isValidId(experienceId) && isValidExperience(incoming());
      allow delete: if isAdmin() && isValidId(experienceId);
    }

    function isValidExperience(data) {
      return data.id is string && data.id.size() <= 128
        && data.company is string && data.company.size() <= 200
        && data.role is string && data.role.size() <= 200
        && data.period is string && data.period.size() <= 100
        && (data.highlights is list && data.highlights.size() <= 30)
        && (data.displayOrder is int);
    }

    // 3. Skills Rules match block
    match /skills/{skillId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(skillId) && isValidSkill(incoming());
      allow update: if isAdmin() && isValidId(skillId) && isValidSkill(incoming());
      allow delete: if isAdmin() && isValidId(skillId);
    }

    function isValidSkill(data) {
      return data.id is string && data.id.size() <= 128
        && data.category in ['Frontend', 'WordPress', 'Backend', 'SEO', 'Performance', 'Security', 'Tools']
        && data.title is string && data.title.size() <= 200
        && (data.skillsList is list && data.skillsList.size() <= 30)
        && (data.displayOrder is int);
    }

    // 4. Messages / Lead contact Rules match block (Strict PII isolation: Admin only reads!)
    match /messages/{messageId} {
      allow create: if isValidId(messageId) && isValidMessage(incoming());
      allow get, list, update, delete: if isAdmin() && isValidId(messageId);
    }

    function isValidMessage(data) {
      return data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 150
        && data.email is string && data.email.size() <= 150
        && data.message is string && data.message.size() <= 5000
        && data.status in ['unread', 'read', 'archived', 'deleted'];
    }
  }
}
